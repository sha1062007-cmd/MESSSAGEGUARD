<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0B0E14"
    android:padding="32dp">

    <!-- Glowing Icon background ring -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_obsidian_card"
        android:layout_marginBottom="36dp">

        <ImageView
            android:id="@+id/iv_illustration"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="#00E5FF"/>
    </FrameLayout>

    <!-- Page Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.03"
        android:layout_marginBottom="16dp"/>

    <!-- Page Subtitle / Description -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#B0BEC5"
        android:lineSpacingExtra="5dp"
        android:letterSpacing="0.02"
        android:layout_marginBottom="28dp"/>

    <!-- Contextual slide button (e.g. Grant Accessibility on Slide 3) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_slide_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GRANT PERMISSION"
        android:textSize="11sp"
        android:textColor="#00E676"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:backgroundTint="#1A00E676"
        app:strokeColor="#3300E676"
        app:strokeWidth="1dp"
        app:cornerRadius="8dp"
        android:visibility="gone"
        android:stateListAnimator="@null"/>
</LinearLayout>
