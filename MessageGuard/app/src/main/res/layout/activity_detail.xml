<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fa">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Case Identifier & Classification Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_case_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_detail_case_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Case ID: LOCAL-SCAN"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textColor="#1A73E8"/>

                    <TextView
                        android:id="@+id/tv_detail_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHISHING"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="#FFEBEE"
                        android:textColor="#C62828"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detail_timestamp_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forensic Ingestion Timestamp"
                    android:textSize="11sp"
                    android:textColor="#757575"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Verdict & Overall Risk Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_detail_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overall Risk Index"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="4dp"/>

                <ProgressBar
                    android:id="@+id/progress_detail_risk"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. ML vs AI Score Breakdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intelligence Signal Breakdown"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- ML Score -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Local ML Classifier"
                        android:textSize="12sp"
                        android:textColor="#424242"/>

                    <ProgressBar
                        android:id="@+id/progress_detail_ml"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_detail_ml_score"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="end"/>
                </LinearLayout>

                <!-- AI Score -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Cloud AI Sentinel"
                        android:textSize="12sp"
                        android:textColor="#424242"/>

                    <ProgressBar
                        android:id="@+id/progress_detail_ai"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_detail_ai_score"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Email Authentication Forensics Card (SPF/DKIM/DMARC) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_authentication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Authentication Forensics"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tv_auth_spf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="SPF: UNKNOWN"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:textColor="#616161"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tv_auth_dkim"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="DKIM: UNKNOWN"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:textColor="#616161"
                        android:layout_marginHorizontal="2dp"/>

                    <TextView
                        android:id="@+id/tv_auth_dmarc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="DMARC: UNKNOWN"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:textColor="#616161"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_auth_domain_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Domain Authorization: NOT EVALUATED"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#424242"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_auth_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Header authentication results determine sender identity authorization."
                    android:textSize="11sp"
                    android:textColor="#757575"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Origin & GeoLocation Intelligence Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_origin_geo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Origin &amp; GeoLocation Intelligence"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tv_geo_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Earliest Relay IP: 127.0.0.1 (Local / Private)"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_geo_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Location: Private / Internal Subnet"
                    android:textSize="12sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_geo_isp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ISP / Autonomous System: Internal Routing"
                    android:textSize="12sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tv_geo_classification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Classification: Direct Transit"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_geo_coordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coordinates: Lat/Lon Unavailable"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="#546E7A"
                    android:layout_marginBottom="10dp"/>

                <!-- Interactive Map Visualization Card / Frame -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_map_container"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#CFD8DC">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <WebView
                            android:id="@+id/webview_forensic_map"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/tv_map_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:background="#ECEFF1"
                            android:padding="16dp"
                            android:text="🌐 Non-Global / Internal IP\nMap visualization not available for private network hops."
                            android:textColor="#78909C"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Observed Relay Sequence -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Observed Relay Sequence:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#37474F"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_relay_sequence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:background="#F5F5F5"
                    android:textColor="#37474F"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Hop 1: [Origin Unknown]" />

                <TextView
                    android:id="@+id/tv_geo_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMPORTANT: Location represents the approximate network infrastructure associated with the observed IP address. It does not establish the sender's exact physical location or identity."
                    android:textSize="10sp"
                    android:textColor="#78909C"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Campaign & Relationship Graph Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_graph_campaign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campaign &amp; Relationship Graph"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_campaign_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Campaign Cluster: Standalone / Unclustered"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entity Relationship Graph:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_graph_tree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp"
                    android:background="#263238"
                    android:textColor="#ECEFF1"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_graph_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Graph Topology: 1 Node (Self)"
                    android:textSize="11sp"
                    android:textColor="#757575"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. Message Body Snippet with Dynamic Highlights -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analyzed Message Snippet"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_message_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#212121"
                    android:background="#f5f5f5"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Highlights Legend -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explainability Highlight Legend:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#FFCDD2"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red: Danger Keywords / Shortener Links"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#FFF9C4"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yellow: Suspicious Patterns (URLs)"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#B2EBF2"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cyan: Model Vocabulary Match"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 8. Forensic Context & Summary -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forensic Summary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red Flags"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_flags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#C62828"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tv_detail_trust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 8.5 Verdict Feedback Control -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_verdict_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CFD8DC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_feedback_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Was this verdict correct?"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tv_feedback_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your feedback trains our local model calibration &amp; fine-tunes future detections."
                    android:textSize="11sp"
                    android:textColor="#78909C"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/layout_feedback_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_feedback_yes"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Correct 👍"
                        android:textSize="12sp"
                        android:textColor="#2E7D32"
                        app:strokeColor="#2E7D32"
                        android:layout_marginEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_feedback_no"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Incorrect 👎"
                        android:textSize="12sp"
                        android:textColor="#C62828"
                        app:strokeColor="#C62828"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_feedback_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thank you! Feedback recorded for model tuning."
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 9. Metadata Details -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_detail_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 10. Forensic PDF Dossier Download Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_pdf_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Forensic PDF Dossier"
            app:icon="@android:drawable/ic_menu_save"
            app:backgroundTint="#00897B"
            android:layout_marginBottom="12dp"/>

        <!-- 11. Open in Gmail Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_in_gmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open in Gmail"
            app:icon="@android:drawable/ic_dialog_email"
            app:backgroundTint="#1A73E8"
            android:layout_marginBottom="12dp"/>

        <!-- 12. Delete Forensic Case Record -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete This Record"
            app:backgroundTint="#EA4335"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
