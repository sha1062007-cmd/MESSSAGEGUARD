<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fa">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Verdict & Overall Risk Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_detail_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overall Risk Index"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="4dp"/>

                <ProgressBar
                    android:id="@+id/progress_detail_risk"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. ML vs AI Score Breakdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intelligence Signal Breakdown"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- ML Score -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Local ML Classifier"
                        android:textSize="12sp"
                        android:textColor="#424242"/>

                    <ProgressBar
                        android:id="@+id/progress_detail_ml"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_detail_ml_score"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="end"/>
                </LinearLayout>

                <!-- AI Score -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Cloud AI Sentinel"
                        android:textSize="12sp"
                        android:textColor="#424242"/>

                    <ProgressBar
                        android:id="@+id/progress_detail_ai"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:layout_marginHorizontal="8dp"/>

                    <TextView
                        android:id="@+id/tv_detail_ai_score"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Message Body Snippet with Dynamic Highlights -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analyzed Message Snippet"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_message_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#212121"
                    android:background="#f5f5f5"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Highlights Legend -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explainability Highlight Legend:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#616161"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#FFCDD2"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red: Danger Keywords / Shortener Links"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#FFF9C4"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yellow: Suspicious Patterns (URLs)"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    
                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#B2EBF2"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cyan: Model Vocabulary Match"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Forensic Context & Summary -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forensic Summary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red Flags"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_flags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#C62828"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tv_detail_trust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_detail_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Metadata Details -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_detail_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_detail_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#5f6368"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <!-- 6. Feedback / Human-in-the-Loop Review Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Was this verdict correct?"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- STATE A: active feedback form -->
                <LinearLayout
                    android:id="@+id/layout_feedback_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Toggle row: Correct / Wrong -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_feedback_correct"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="✓  Correct"
                            android:textSize="12sp"
                            android:textColor="#2E7D32"
                            app:backgroundTint="#1A2E7D32"
                            app:strokeColor="#222E7D32"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp"
                            android:stateListAnimator="@null"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_feedback_wrong"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="✗  Wrong"
                            android:textSize="12sp"
                            android:textColor="#C62828"
                            app:backgroundTint="#1AC62828"
                            app:strokeColor="#22C62828"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp"
                            android:stateListAnimator="@null"/>
                    </LinearLayout>

                    <!-- Sub-form: shown only after tapping Wrong -->
                    <LinearLayout
                        android:id="@+id/layout_false_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_false_report_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#C62828"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="What tipped you off? (optional)"
                            android:layout_marginBottom="10dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_feedback_note"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapSentences"
                                android:maxLines="2"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_submit_feedback"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="SUBMIT REPORT"
                            android:textSize="12sp"
                            android:textColor="#E65100"
                            app:backgroundTint="#1AE65100"
                            app:strokeColor="#22E65100"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp"
                            android:stateListAnimator="@null"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- STATE B: confirmation chip (collapsed, tappable to expand) -->
                <TextView
                    android:id="@+id/tv_feedback_confirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feedback recorded ✓  (tap to view)"
                    android:textSize="12sp"
                    android:textColor="#2E7D32"
                    android:background="#1A2E7D32"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone"/>

                <!-- STATE C: read-only submitted feedback view -->
                <LinearLayout
                    android:id="@+id/layout_feedback_readonly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_readonly_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#424242"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tv_readonly_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:textColor="#616161"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tv_collapse_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(tap to collapse)"
                        android:textSize="10sp"
                        android:textColor="#757575"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete This Record"
            app:backgroundTint="#EA4335"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>

