<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:keepScreenOn="true">

    <!-- ViewPager2 for sliding slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_bottom"/>

    <!-- Bottom control area -->
    <RelativeLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical">

        <!-- Indicator helper text (e.g. Page 1 of 3) -->
        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 3"
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:letterSpacing="0.05"/>

        <!-- Action Button (NEXT / GET STARTED) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:text="NEXT"
            android:textSize="12sp"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:backgroundTint="#1A00E5FF"
            app:strokeColor="#3300E5FF"
            app:strokeWidth="1dp"
            app:cornerRadius="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:stateListAnimator="@null"/>
    </RelativeLayout>
</RelativeLayout>
