<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_container"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_obsidian"
    android:elevation="24dp"
    android:padding="16dp">

    <!-- 1. LOADING STATE GROUP -->
    <LinearLayout
        android:id="@+id/loading_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/loading_spinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="#00E5FF"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analysing message..."
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            android:letterSpacing="0.05"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coordinating ML &amp; AI Forensics"
            android:textSize="10sp"
            android:textColor="#607D8B"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.03"/>
    </LinearLayout>

    <!-- 2. RESULT STATE GROUP -->
    <LinearLayout
        android:id="@+id/result_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header row: verdict label + settings icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_verdict"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.04"/>

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_preferences"
                android:scaleType="centerInside"
                android:contentDescription="Settings"
                android:tint="#607D8B"/>
        </LinearLayout>

        <!-- Score bars row: ML | AI | Overall -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <!-- ML Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ML Score"
                    android:textSize="9sp"
                    android:textColor="#607D8B"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="4dp"/>
                <ProgressBar
                    android:id="@+id/progress_ml"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#1AFFFFFF"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/tv_ml_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E0E0E0"/>
            </LinearLayout>

            <!-- AI Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Score"
                    android:textSize="9sp"
                    android:textColor="#607D8B"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="4dp"/>
                <ProgressBar
                    android:id="@+id/progress_ai"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#1AFFFFFF"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/tv_ai_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E0E0E0"/>
            </LinearLayout>

            <!-- Overall Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overall"
                    android:textSize="9sp"
                    android:textColor="#607D8B"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="4dp"/>
                <ProgressBar
                    android:id="@+id/progress_overall"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#1AFFFFFF"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:id="@+id/tv_overall_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E0E0E0"/>
            </LinearLayout>
        </LinearLayout>

        <!-- AI Summary -->
        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#B0BEC5"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="3dp"/>

        <!-- Why Flagged -->
        <TextView
            android:id="@+id/tv_why_flagged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="#FF5252"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            android:lineSpacingExtra="2dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_see_report"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="FULL REPORT"
                android:textSize="10sp"
                android:textColor="#00E5FF"
                android:backgroundTint="#1A00E5FF"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btn_close_bubble"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="DISMISS"
                android:textSize="10sp"
                android:textColor="#607D8B"
                android:backgroundTint="#0DFFFFFF"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Expanded section -->
        <LinearLayout
            android:id="@+id/expanded_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="14dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_flags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#FF5252"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_sender_trust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#90A4AE"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E0E0E0"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_save_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVE TO HISTORY"
                android:textColor="#00E5FF"
                android:backgroundTint="#1A00E5FF"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
