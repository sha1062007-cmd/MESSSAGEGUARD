# MessageGuard - Resend API Configuration
# Use this configuration for high-reliability cloud alerts

# Get your API key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Recipient email address
ALERT_EMAIL=your_email@example.com

# Verified sender (must be authorized in Resend dashboard)
# Default for testing: MessageGuard <alerts@resend.dev>
ALERT_FROM=MessageGuard <alerts@yourdomain.com>

# Alert Controls
ALERT_ON_SUSPICIOUS=true
ALERT_ON_DANGEROUS=true
ENABLE_COOLDOWN=true
